<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouTube Shorts</title>
    
    <!-- Настройки, чтобы Telegram показал превью YouTube -->
    <meta property="og:title" content="Когда попытался настроить код с первого раза 💀 #shorts">
    <meta property="og:image" content="https://i.ytimg.com/vi/dQw4w9WgXcQ/maxresdefault.jpg">
    <meta property="og:type" content="video.other">

    <style>
        body {
            margin: 0;
            background-color: #000;
            color: #00ff00;
            font-family: monospace;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .box {
            border: 2px solid #00ff00;
            padding: 30px;
            background: #001100;
            text-align: center;
            box-shadow: 0 0 20px #00ff00;
        }
        h1 { color: #ff3333; }
    </style>
</head>
<body>
    <div class="box" id="prank">
        <h1>⚠️ ТЕЛЕФОН ВЗЛОМАН</h1>
        <p>Скачивание галереи и паролей...</p>
        <p>Прогресс: <span id="load">10</span>%</p>
    </div>

    <script>
        let p = 10;
        let timer = setInterval(() => {
            p += 20;
            if (p >= 100) {
                clearInterval(timer);
                document.getElementById('prank').innerHTML = `
                    <h1 style="color: #00ff00;">РОЗЫГРЫШ УДАЛЕНСЯ! 😂</h1>
                    <p>Твой телефон в полной безопасности!</p>
                `;
            } else {
                document.getElementById('load').innerText = p;
            }
        }, 600);
    </script>
</body>
</html>
